<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vms="clr-namespace:ProjectF.Core.ViewModels;assembly=ProjectF.Core"
             x:DataType="vms:PlaybooksViewModel"
             x:Class="ProjectF.UI.Playbooks"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Button Command="{Binding NavigateToPlaybooksCommand}"
                HeightRequest="40"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="3"
                Text="Back"
                WidthRequest="120"/>
        <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="20">
            <Button HeightRequest="40"
                    Text="View Playbooks"
                    WidthRequest="250"/>
            <Button Command="{Binding NavigateToCreateOffensivePlayCommand}"
                    HeightRequest="40"
                    Text="Create Offensive Play"
                    WidthRequest="250"/>
            <Button HeightRequest="40"
                    Text="Create Defensive Play"
                    WidthRequest="250"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>